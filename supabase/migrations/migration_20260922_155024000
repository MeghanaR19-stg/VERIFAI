-- VERIFAI prototype schema (project-owned, prefixed to avoid collisions in the shared Cloud)

create table if not exists verifai_tenders (
  id text primary key,
  name text not null,
  department text not null,
  status text not null default 'ACTIVE',
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists verifai_requirements (
  id text primary key,
  tender_id text not null references verifai_tenders(id),
  label text not null,
  requirement_type text not null,
  threshold_value numeric,
  threshold_unit text,
  display_value text not null,
  mandatory boolean not null default true,
  verification_method text not null,
  sort_order integer not null default 0
);

create table if not exists verifai_bidders (
  id text primary key,
  name text not null,
  registered_name text not null,
  turnover_cr numeric not null default 0,
  similar_projects integer not null default 0,
  experience_years integer not null default 0,
  gst_status text not null default 'ACTIVE',
  gstin text,
  oem_authorization boolean not null default false,
  iso_13485 boolean not null default false,
  udyam_number text,
  pan text,
  city text,
  data_notice text not null default 'Synthetic demonstration data — not a live government record.'
);

create table if not exists verifai_submissions (
  id text primary key,
  tender_id text not null references verifai_tenders(id),
  bidder_id text not null references verifai_bidders(id),
  submitted_at timestamptz not null default now(),
  status text not null default 'SUBMITTED',
  compliance_score numeric,
  risk_level text,
  overall_status text,
  ai_summary text,
  ai_mode text,
  ai_findings jsonb,
  verified_at timestamptz
);

create table if not exists verifai_documents (
  id uuid primary key default gen_random_uuid(),
  submission_id text not null references verifai_submissions(id),
  name text not null,
  doc_type text not null,
  status text not null default 'EXTRACTED',
  source_page integer,
  extraction_method text not null default 'PROTOTYPE EXTRACTION',
  confidence numeric,
  extracted_fields jsonb,
  uploaded_by text not null default 'SYSTEM',
  created_at timestamptz not null default now()
);

create table if not exists verifai_evidence (
  id uuid primary key default gen_random_uuid(),
  submission_id text not null references verifai_submissions(id),
  requirement_id text not null references verifai_requirements(id),
  result text not null,
  method text not null,
  extracted_value text,
  source_document text,
  source_page integer,
  rule_expression text,
  reasoning text,
  confidence numeric,
  created_at timestamptz not null default now()
);

create table if not exists verifai_verifications (
  id uuid primary key default gen_random_uuid(),
  bidder_id text not null references verifai_bidders(id),
  check_type text not null,
  identifier text,
  status text not null,
  source_adapter text not null,
  detail text,
  checked_at timestamptz not null default now()
);

create table if not exists verifai_audit_events (
  id uuid primary key default gen_random_uuid(),
  occurred_at timestamptz not null default now(),
  actor text not null default 'SYSTEM',
  actor_name text not null default 'VERIFAI Engine',
  action text not null,
  entity_type text not null,
  entity_id text,
  entity_label text,
  status text,
  detail text
);

create table if not exists verifai_decisions (
  id uuid primary key default gen_random_uuid(),
  submission_id text not null unique references verifai_submissions(id),
  decision text not null,
  comment text,
  decided_by text not null default 'Procurement Officer',
  decided_at timestamptz not null default now()
);

create table if not exists verifai_app_state (
  key text primary key,
  value jsonb not null,
  updated_at timestamptz not null default now()
);

-- Row level security: enabled in the same migration that creates each table.
alter table verifai_tenders enable row level security;
alter table verifai_requirements enable row level security;
alter table verifai_bidders enable row level security;
alter table verifai_submissions enable row level security;
alter table verifai_documents enable row level security;
alter table verifai_evidence enable row level security;
alter table verifai_verifications enable row level security;
alter table verifai_audit_events enable row level security;
alter table verifai_decisions enable row level security;
alter table verifai_app_state enable row level security;

-- Read access for the unauthenticated demo console (synthetic data only).
create policy verifai_tenders_read on verifai_tenders for select to anon, authenticated using (true);
create policy verifai_requirements_read on verifai_requirements for select to anon, authenticated using (true);
create policy verifai_bidders_read on verifai_bidders for select to anon, authenticated using (true);
create policy verifai_submissions_read on verifai_submissions for select to anon, authenticated using (true);
create policy verifai_documents_read on verifai_documents for select to anon, authenticated using (true);
create policy verifai_evidence_read on verifai_evidence for select to anon, authenticated using (true);
create policy verifai_verifications_read on verifai_verifications for select to anon, authenticated using (true);
create policy verifai_audit_events_read on verifai_audit_events for select to anon, authenticated using (true);
create policy verifai_decisions_read on verifai_decisions for select to anon, authenticated using (true);
create policy verifai_app_state_read on verifai_app_state for select to anon, authenticated using (true);

-- Officer-facing writes: document metadata upload, simulated re-verification,
-- audit events, the officer decision, and demo-mode state.
create policy verifai_documents_insert on verifai_documents for insert to anon, authenticated with check (true);
create policy verifai_verifications_insert on verifai_verifications for insert to anon, authenticated with check (true);
create policy verifai_verifications_update on verifai_verifications for update to anon, authenticated using (true) with check (true);
create policy verifai_audit_events_insert on verifai_audit_events for insert to anon, authenticated with check (true);
create policy verifai_decisions_insert on verifai_decisions for insert to anon, authenticated with check (true);
create policy verifai_decisions_update on verifai_decisions for update to anon, authenticated using (true) with check (true);
create policy verifai_app_state_insert on verifai_app_state for insert to anon, authenticated with check (true);
create policy verifai_app_state_update on verifai_app_state for update to anon, authenticated using (true) with check (true);

create index if not exists verifai_requirements_tender_idx on verifai_requirements (tender_id, sort_order);
create index if not exists verifai_submissions_tender_idx on verifai_submissions (tender_id);
create index if not exists verifai_submissions_bidder_idx on verifai_submissions (bidder_id);
create index if not exists verifai_documents_submission_idx on verifai_documents (submission_id);
create index if not exists verifai_evidence_submission_idx on verifai_evidence (submission_id);
create index if not exists verifai_evidence_requirement_idx on verifai_evidence (requirement_id);
create index if not exists verifai_verifications_bidder_idx on verifai_verifications (bidder_id);
create index if not exists verifai_audit_events_occurred_idx on verifai_audit_events (occurred_at desc);
create index if not exists verifai_audit_events_entity_idx on verifai_audit_events (entity_id);